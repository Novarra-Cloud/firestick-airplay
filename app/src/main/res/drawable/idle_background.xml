<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/bg_bottom"
                android:startColor="@color/bg_top" />
        </shape>
    </item>
    <!-- soft blue glow in the upper left -->
    <item>
        <shape>
            <gradient
                android:centerX="0.15"
                android:centerY="0.2"
                android:endColor="#00000000"
                android:gradientRadius="700"
                android:startColor="#332B6CB0"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
